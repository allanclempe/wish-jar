// The API: hosts each family's online jar, shared by the family's devices
// (WJ-46), and lets a parent send a photo from their phone to Wish Jar on a
// device that can't pick one itself (WJ-41). Runs on the Workers Free plan;
// README.md has the limits that keep one caller from using it up for every
// family (WJ-51), and the edge rules. Merges to main that touch apps/api/ or
// packages/jar/ deploy it (.github/workflows/api.yml); its address is
// API_ADDRESS in apps/mobile/src/apiUrl.ts.
{
  "$schema": "node_modules/wrangler/config-schema.json",
  // Its name from when it was the photo relay. A new name would be a new
  // Worker, without the Durable Objects that hold every family's jar, so it
  // stays until they're moved over (WJ-72). The site's service binding
  // (apps/mobile/wrangler.jsonc) and the workers.dev address use it too.
  "name": "wish-jar-photo-relay",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-01",
  "observability": { "enabled": true },
  // The address parents see and type on their phone (WJ-63). The site took
  // over wish-jar.blastin.dev and passes the API's paths there on to this
  // Worker (site/worker.js), for photo URLs and devices still holding it.
  // Photo URLs (WJ-49) start with the address a device called, so `pnpm dev`
  // keeps wrangler from rewriting it to this route (--local-upstream
  // localhost:8787; match it to --port).
  "routes": [{ "pattern": "wish-jar-api.blastin.dev", "custom_domain": true }],
  // The workers.dev address stays on for the builds from before WJ-42 that
  // call it, but answers only their photo-code paths (WJ-58,
  // WORKERS_DEV_PATHS in src/routes.ts). Turn it off once those builds are
  // gone. Preview URLs are workers.dev
  // addresses too, each running an old version of the Worker, so they're off.
  "workers_dev": true,
  "preview_urls": false,
  "durable_objects": {
    "bindings": [
      { "name": "PHOTO_DROPS", "class_name": "PhotoDrop" },
      { "name": "FAMILY_JARS", "class_name": "FamilyJar" },
      { "name": "JOIN_CODES", "class_name": "JoinCode" },
      { "name": "JOIN_ATTEMPTS", "class_name": "JoinAttempts" },
      { "name": "ECHO_SHOW_LINKS", "class_name": "EchoShowLink" },
      { "name": "CALLER_LIMITS", "class_name": "CallerLimits" },
      { "name": "FAMILY_STARTS", "class_name": "FamilyStarts" }
    ]
  },
  // Anonymous usage counts (WJ-82, src/usage.ts): each data point is only an
  // event's name. Analytics Engine makes the dataset on its first write.
  "analytics_engine_datasets": [{ "binding": "USAGE", "dataset": "wish_jar_usage" }],
  // SQLite-backed, the only Durable Objects the Free plan has.
  "migrations": [
    { "tag": "v1", "new_sqlite_classes": ["PhotoDrop"] },
    { "tag": "v2", "new_sqlite_classes": ["FamilyJar"] },
    { "tag": "v3", "new_sqlite_classes": ["JoinCode", "JoinAttempts"] },
    { "tag": "v4", "new_sqlite_classes": ["EchoShowLink"] },
    { "tag": "v5", "new_sqlite_classes": ["CallerLimits"] },
    { "tag": "v6", "new_sqlite_classes": ["FamilyStarts"] }
  ],
  "vars": {
    // Pages allowed to use codes and the family jar (CORS), comma-separated:
    // the site (which the Echo Show and the Frameo frame open too) and the
    // dev server. A device's token, signed since WJ-55, is what opens a
    // family's jar.
    "ALLOWED_ORIGINS": "https://wish-jar.blastin.dev,http://localhost:8081",
    // Where a join code's QR code sends a phone: Wish Jar with the code
    // filled in (WJ-48). `pnpm dev --var APP_URL:http://localhost:8081` for
    // the dev server.
    "APP_URL": "https://wish-jar.blastin.dev",
    // The per-caller limits and the daily count of new families (README.md,
    // "Per-caller limits in the Worker"). `pnpm dev` turns them off, so
    // starting families over and over while working on the app doesn't lock
    // the developer out for a day.
    "LIMITS": "on"
  },
  // The Turnstile widget's secret key, which checks the token a new family
  // brings (WJ-54). The deploy job uploads it and SIGNING_KEY from the
  // "production" environment's secrets in GitHub (README.md), and a deploy
  // fails while either isn't set. `pnpm dev` and the tests use Cloudflare's
  // test key, which passes the test widget's dummy token.
  //
  // SIGNING_KEY signs device tokens and photo URLs (WJ-55, src/signing.ts),
  // so the Worker turns away made-up ones without waking a family's jar.
  // Changing it turns away every token and photo URL already handed out.
  // `pnpm dev` and the tests use a key of their own.
  //
  // CACHE_PURGE_TOKEN and CACHE_PURGE_ZONE_ID purge a deleted photo from the
  // edge cache in every data centre (WJ-59, src/cachePurge.ts): a token of
  // its own allowed only Zone → Cache Purge → Purge on blastin.dev, and that
  // zone's id. `wrangler secret put CACHE_PURGE_TOKEN` and `wrangler secret
  // put CACHE_PURGE_ZONE_ID` (README.md). Optional, so they're not listed
  // here and a deploy goes ahead without them: until they're set, a deleted
  // photo is only forgotten in the data centre that deleted it. `pnpm dev`
  // purges nothing; the tests use made-up ones and answer for the purge API.
  "secrets": { "required": ["TURNSTILE_SECRET_KEY", "SIGNING_KEY"] }
}
