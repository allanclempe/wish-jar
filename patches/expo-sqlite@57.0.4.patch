index 0000000000000000000000000000000000000000..387c697d326ae6039ccae8adbfd42bd073d42471
--- /dev/null
+++ b/web/wa-sqlite/IndexedDBSnapshotVFS.js
@@ -0,0 +1,89 @@
+// In-memory filesystem whose database files are saved to IndexedDB, for browsers without OPFS
+// sync access handles (Android WebView 106 on Android 6, the last version it gets).
+//
+// SQLite calls xSync on the main database file once a transaction's pages are written, so a copy
+// taken there is always a committed state. That copy is written to IndexedDB in one transaction.
+// Only the newest copy waits while a write is in flight, so a burst of commits costs one extra
+// write, not one per commit. Journals stay in memory: a saved file never needs one to recover.
+import { MemoryVFS } from './MemoryVFS.js';
+import * as VFS from './VFS.js';
+
+const STORE = 'files';
+
+function request(req) {
+  return new Promise((resolve, reject) => {
+    req.onsuccess = () => resolve(req.result);
+    req.onerror = () => reject(req.error);
+  });
+}
+
+export class IndexedDBSnapshotVFS extends MemoryVFS {
+  static isNeeded() {
+    return typeof navigator.storage?.getDirectory !== 'function';
+  }
+
+  static async create(name, module) {
+    const vfs = new IndexedDBSnapshotVFS(name, module);
+    await vfs.isReady();
+    return vfs;
+  }
+
+  db = null;
+  // Newest committed copy waiting to be saved, and whether a save is running, keyed by pathname.
+  pendingCopies = new Map();
+  saving = new Set();
+
+  async isReady() {
+    const open = indexedDB.open(this.name, 1);
+    open.onupgradeneeded = () => open.result.createObjectStore(STORE);
+    this.db = await request(open);
+    const tx = this.db.transaction(STORE, 'readonly');
+    const [names, contents] = await Promise.all([
+      request(tx.objectStore(STORE).getAllKeys()),
+      request(tx.objectStore(STORE).getAll()),
+    ]);
+    names.forEach((pathname, i) => {
+      const data = contents[i];
+      this.mapNameToFile.set(pathname, {
+        pathname,
+        flags: VFS.SQLITE_OPEN_MAIN_DB,
+        size: data.byteLength,
+        data,
+      });
+    });
+    return true;
+  }
+
+  jSync(fileId, flags) {
+    const file = this.mapIdToFile.get(fileId);
+    if (file && file.flags & VFS.SQLITE_OPEN_MAIN_DB) {
+      this.pendingCopies.set(file.pathname, file.data.slice(0, file.size));
+      if (!this.saving.has(file.pathname)) this.saveNext(file.pathname);
+    }
+    return VFS.SQLITE_OK;
+  }
+
+  jDelete(name, syncDir) {
+    const pathname = new URL(name, 'file://').pathname;
+    this.pendingCopies.delete(pathname);
+    this.db.transaction(STORE, 'readwrite').objectStore(STORE).delete(pathname);
+    return super.jDelete(name, syncDir);
+  }
+
+  saveNext(pathname) {
+    const data = this.pendingCopies.get(pathname);
+    if (!data) {
+      this.saving.delete(pathname);
+      return;
+    }
+    this.pendingCopies.delete(pathname);
+    this.saving.add(pathname);
+    const tx = this.db.transaction(STORE, 'readwrite');
+    tx.objectStore(STORE).put(data, pathname);
+    tx.oncomplete = () => this.saveNext(pathname);
+    tx.onerror = tx.onabort = () => {
+      console.error(`Failed to save ${pathname} to IndexedDB`, tx.error);
+      this.saveNext(pathname);
+    };
+  }
+}
