// The photo relay: lets a parent send a photo from their phone to Wish Jar on
// a device that can't pick one itself (WJ-41). It also hosts each family's
// online jar, shared by the family's devices (WJ-46). Runs on the Workers Free
// plan; relay/README.md has the limits that keep one caller from using it up
// for every family (WJ-51), and the edge rule set in Cloudflare's dashboard.
// Merges to main that touch relay/ deploy it (.github/workflows/relay.yml);
// its address is PHOTO_RELAY_URL in src/photos/phoneRelay.ts.
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "wish-jar-photo-relay",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-01",
  "observability": { "enabled": true },
  // The address parents see and type on their phone (WJ-63). The site took
  // over wish-jar.blastin.dev and passes the relay's paths there on to this
  // Worker (site/worker.js), for photo URLs and devices still holding it. The
  // workers.dev address stays on too. Photo URLs (WJ-49) start with
  // the address a device called, so `pnpm dev` keeps wrangler from rewriting
  // it to this route (--local-upstream localhost:8787; match it to --port).
  "routes": [{ "pattern": "wish-jar-api.blastin.dev", "custom_domain": true }],
  "workers_dev": true,
  "durable_objects": {
    "bindings": [
      { "name": "PHOTO_DROPS", "class_name": "PhotoDrop" },
      { "name": "FAMILY_JARS", "class_name": "FamilyJar" },
      { "name": "JOIN_CODES", "class_name": "JoinCode" },
      { "name": "JOIN_ATTEMPTS", "class_name": "JoinAttempts" },
      { "name": "ECHO_SHOW_LINKS", "class_name": "EchoShowLink" },
      { "name": "CALLER_LIMITS", "class_name": "CallerLimits" },
      { "name": "FAMILY_STARTS", "class_name": "FamilyStarts" }
    ]
  },
  // SQLite-backed, the only Durable Objects the Free plan has.
  "migrations": [
    { "tag": "v1", "new_sqlite_classes": ["PhotoDrop"] },
    { "tag": "v2", "new_sqlite_classes": ["FamilyJar"] },
    { "tag": "v3", "new_sqlite_classes": ["JoinCode", "JoinAttempts"] },
    { "tag": "v4", "new_sqlite_classes": ["EchoShowLink"] },
    { "tag": "v5", "new_sqlite_classes": ["CallerLimits"] },
    { "tag": "v6", "new_sqlite_classes": ["FamilyStarts"] }
  ],
  "vars": {
    // Pages allowed to use codes and the family jar (CORS), comma-separated:
    // the site, the dev server, and the frame app's own pages
    // (frame/README.md).
    "ALLOWED_ORIGINS": "https://wish-jar.blastin.dev,http://localhost:8081,https://appassets.androidplatform.net",
    // Where a join code's QR code sends a phone: Wish Jar with the code
    // filled in (WJ-48). `pnpm dev --var APP_URL:http://localhost:8081` for
    // the dev server.
    "APP_URL": "https://wish-jar.blastin.dev"
  },
  // The Turnstile widget's secret key, which checks the token a new family
  // brings (WJ-54): `wrangler secret put TURNSTILE_SECRET_KEY` (README.md). A
  // deploy fails while it isn't set. `pnpm dev` and the tests use Cloudflare's
  // test key, which passes the test widget's dummy token.
  //
  // SIGNING_KEY signs device tokens and photo URLs (WJ-55, src/signing.ts),
  // so the Worker turns away made-up ones without waking a family's jar:
  // `wrangler secret put SIGNING_KEY` (README.md). Changing it turns away
  // every token and photo URL already handed out. `pnpm dev` and the tests
  // use a key of their own.
  "secrets": { "required": ["TURNSTILE_SECRET_KEY", "SIGNING_KEY"] }
}
